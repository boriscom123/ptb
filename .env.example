# Скопируйте в .env и заполните. Файл .env не коммитится.

# --- Домен ---
APP_DOMAIN=150-241-105-178.sslip.io

# --- Laravel ---
APP_NAME=PTB
APP_ENV=local
# Сгенерировать: docker compose run --rm app php artisan key:generate --show
APP_KEY=
APP_DEBUG=true
APP_URL=https://${APP_DOMAIN}
APP_LOCALE=ru
APP_FALLBACK_LOCALE=en

LOG_CHANNEL=stack
LOG_STACK=daily
LOG_LEVEL=debug

# --- PostgreSQL ---
DB_CONNECTION=pgsql
DB_HOST=postgres
DB_PORT=5432
DB_DATABASE=ptb
DB_USERNAME=ptb
# Сгенерировать: openssl rand -hex 24
DB_PASSWORD=

# --- Redis ---
REDIS_CLIENT=phpredis
REDIS_HOST=redis
REDIS_PORT=6379

CACHE_STORE=redis
QUEUE_CONNECTION=redis
SESSION_DRIVER=array

# --- Telegram (этап 2) ---
# Токен бота от @BotFather
TELEGRAM_TOKEN=
# Ваш Telegram ID (узнать: @userinfobot) — первый администратор
ADMIN_TELEGRAM_ID=

# --- Claude (этап 5) ---
# Получить: claude setup-token
CLAUDE_CODE_OAUTH_TOKEN=
